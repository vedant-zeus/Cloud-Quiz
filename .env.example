# ==============================================================================
# CloudQuiz Environment Configuration Reference
# ==============================================================================
# Use this reference when deploying to Railway (Backend) and Vercel (Frontend),
# or copy this file to .env for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Service Configuration (Railway Variables)
# ------------------------------------------------------------------------------
# The port is automatically assigned by Railway ($PORT). Defaults to 4000 locally.
PORT=4000
NODE_ENV=production
API_PREFIX=/api/v1

# Allowed Frontend Origins (Comma-separated for multiple origins, e.g. Vercel + custom domains)
# Example: https://cloudquiz.vercel.app,https://cloudquiz-git-main-yourteam.vercel.app
CORS_ORIGIN=https://your-frontend.vercel.app

# PostgreSQL Database Connection
# In Railway, use the reference ${{Postgres.DATABASE_URL}} from the Railway PostgreSQL plugin
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway?sslmode=prefer

# Authentication & Security Secrets (Generate secure 32+ character random strings)
JWT_SECRET=replace-with-a-cryptographically-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d
CSRF_SECRET=replace-with-a-cryptographically-random-string-at-least-32-characters
COOKIE_SECRET=replace-with-a-cryptographically-random-string-at-least-32-characters

# Production Cookie Security Settings
# When frontend is on Vercel (*.vercel.app) and backend is on Railway (*.railway.app),
# cookies must be cross-site: COOKIE_SECURE=true and COOKIE_SAME_SITE=none
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# Optional Redis URL (NOT required for Phase 4 single-backend deployment; omit to save cost)
# REDIS_URL=redis://...

# ------------------------------------------------------------------------------
# 2. Frontend Configuration (Vercel Environment Variables)
# ------------------------------------------------------------------------------
# Set these under Vercel Project Settings > Environment Variables:
# VITE_API_BASE_URL=https://your-backend.up.railway.app/api/v1
# VITE_SOCKET_URL=https://your-backend.up.railway.app

# ------------------------------------------------------------------------------
# 3. Local Development Overrides (.env)
# ------------------------------------------------------------------------------
# For local dev:
# NODE_ENV=development
# CORS_ORIGIN=http://localhost:5173
# DATABASE_URL=postgresql://cloudquiz:cloudquiz_dev_secret@localhost:5434/cloudquiz_dev?schema=public
# TEST_DATABASE_URL=postgresql://cloudquiz:cloudquiz_dev_secret@localhost:5434/cloudquiz_test?schema=public
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax
